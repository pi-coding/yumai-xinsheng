.cover {
  height: 420rpx; border-radius: 24rpx; position: relative;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
}
.cover-frame {
  position: absolute; left: 26rpx; right: 26rpx; top: 26rpx; bottom: 26rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.34); border-radius: 14rpx;
}
.cover-title {
  color: #ffffff; font-weight: 700; letter-spacing: 10rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  text-align: center; line-height: 1.35;
}
.cover-era {
  color: rgba(255, 255, 255, 0.75); font-size: 24rpx;
  letter-spacing: 4rpx; margin-top: 20rpx;
}

.v.b { font-weight: 700; }
.v.intro { text-align: left; line-height: 1.7; font-size: 26rpx; }

.acts { display: flex; flex-direction: column; gap: 18rpx; margin-top: 32rpx; }

/* ---------------- 增强层 ---------------- */
.sec { margin-top: 36rpx; }
.sec-t {
  display: flex; align-items: baseline; flex-wrap: wrap;
  font-size: 28rpx; font-weight: 700; color: #333333;
  padding-bottom: 14rpx; border-bottom: 1rpx solid #ece8df;
}
.sec-t .dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: #b8860b; margin-right: 12rpx; flex: none;
}
.sec-n {
  font-size: 21rpx; font-weight: 400; color: #9a9a9a;
  margin-left: 12rpx; line-height: 1.6;
}
.sec-sub {
  display: flex; align-items: baseline; flex-wrap: wrap;
  margin: 20rpx 0 12rpx;
}
.sec-empty {
  font-size: 24rpx; color: #8f8f8f; line-height: 1.8;
  padding: 16rpx 0 4rpx;
}
.tag-o {
  font-size: 21rpx; color: #3d7a4f; background: #eaf3ec;
  border: 1rpx solid #cfe3d5; border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.bu-note {
  margin-top: 16rpx;
  background: #fdfaf2; border: 1rpx solid #efe6d2;
  border-left: 6rpx solid #b8860b; border-radius: 12rpx;
  padding: 20rpx 22rpx;
  font-size: 25rpx; line-height: 1.85; color: #5a5346;
}

.quote {
  margin-top: 16rpx;
  background: #f7f6f2; border-left: 6rpx solid #b8860b;
  border-radius: 12rpx; padding: 20rpx 22rpx;
}
.quote-text {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 31rpx; line-height: 1.85; color: #2f2a24;
  letter-spacing: 1rpx;
}
.quote-foot {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 12rpx;
}
.quote-from { font-size: 21rpx; color: #9a9a9a; flex: 1; }
.quote-act {
  font-size: 22rpx; color: #3d7a4f; flex: none;
  padding: 6rpx 16rpx; border: 1rpx solid #cfe3d5; border-radius: 24rpx;
  background: #eaf3ec;
}

.pair {
  margin-top: 16rpx; padding: 20rpx 22rpx;
  background: #ffffff; border: 1rpx solid #efece4; border-radius: 12rpx;
}
.pair.dim { background: #fbfaf7; }
.p-modern { font-size: 24rpx; color: #8f8f8f; }
.p-ancient {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 30rpx; color: #a8322d; margin-top: 8rpx; line-height: 1.7;
}
.p-src { font-size: 21rpx; color: #9a9a9a; margin-top: 8rpx; }

.chips { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.chip {
  font-size: 23rpx; color: #3d7a4f; background: #eaf3ec;
  border: 1rpx solid #cfe3d5; border-radius: 24rpx;
  padding: 8rpx 20rpx; margin: 0 12rpx 12rpx 0;
}
.chip-n { font-size: 19rpx; color: #7f9c88; }

.bu-intro {
  margin-top: 36rpx;
  background: #f3f7f4; border: 1rpx solid #dfeae2; border-radius: 12rpx;
  padding: 20rpx 22rpx;
  font-size: 24rpx; line-height: 1.85; color: #55635a;
}
.bi-b { font-weight: 700; color: #3d7a4f; }
