/* 模块三：语言改编工坊 */
.ws-head {
  display: flex; align-items: flex-start; justify-content: space-between;
  margin-bottom: 26rpx;
}
.ws-t { font-size: 38rpx; font-weight: 800; letter-spacing: 2rpx; }
.ws-s { font-size: 23rpx; color: #8f8f8f; margin-top: 6rpx; }
.gear {
  width: 66rpx; height: 66rpx; border-radius: 16rpx;
  background: #ffffff; border: 1rpx solid #e8e5de;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx;
}

.modes { display: flex; flex-wrap: wrap; margin-bottom: 8rpx; }

/* 参数折叠行：默认只露当前值，点开才展开三个 picker */
.param-fold {
  margin-top: 6rpx; padding: 18rpx 0 6rpx;
  border-top: 1rpx solid #f0eee8;
}
.sels { display: flex; flex-direction: column; gap: 14rpx; margin-top: 8rpx; }
.sel { width: 100%; }
.sel-in {
  display: flex; align-items: center; justify-content: space-between;
  background: #faf9f6; border: 1rpx solid #f0eee8; border-radius: 14rpx;
  padding: 20rpx 24rpx;
}
.sel-l { font-size: 25rpx; color: #8f8f8f; }
.sel-v { font-size: 27rpx; font-weight: 600; color: #3d7a4f; }

/* 输入区 */
.ta {
  width: 100%; min-height: 190rpx;
  background: #faf9f6; border: 1rpx solid #f0eee8; border-radius: 16rpx;
  padding: 24rpx; font-size: 28rpx; line-height: 1.7;
}
.ta-ph { color: #b5b5b5; }
.ta-foot {
  display: flex; align-items: center; justify-content: space-between;
  margin: 12rpx 0 20rpx;
}
.cnt { font-size: 22rpx; color: #b5b5b5; }
.clr { font-size: 24rpx; color: #3f7d9c; }

.egs { margin-bottom: 24rpx; }
.eg-lb { font-size: 23rpx; color: #8f8f8f; }
.eg-wrap { margin-top: 12rpx; }

/* 输出区 */
.res {
  background: linear-gradient(135deg, #fdf6e6, #faf6ec);
  border: 1rpx solid #f0e2c2; border-radius: 16rpx;
  padding: 30rpx 26rpx;
  font-size: 32rpx; line-height: 1.85; color: #2b2b2b;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  letter-spacing: 1rpx;
  word-break: break-all;
}
.meta { margin-top: 20rpx; }
.mg {
  display: flex; gap: 10rpx;
  font-size: 23rpx; color: #5f5f5f; line-height: 1.8;
}
.dot { color: #b8860b; }
.out-acts { display: flex; gap: 18rpx; margin-top: 26rpx; }

/* 作品／历史 */
.pitem { padding: 22rpx 0; border-bottom: 1rpx solid #f0eee8; }
.pitem:last-child { border-bottom: none; }
.pt { font-size: 27rpx; line-height: 1.7; }
.pm {
  display: flex; align-items: center; gap: 16rpx;
  margin-top: 10rpx; font-size: 22rpx; color: #b5b5b5;
}
.dir { color: #3d7a4f; background: #eaf3ec; border-radius: 6rpx; padding: 2rpx 12rpx; }
.at { flex: 1; }
.del { color: #c0504d; padding: 0 8rpx; }
.reuse { color: #3f7d9c; }
