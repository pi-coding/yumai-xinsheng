/* 模块二：古籍书库 */
.toolbar { margin-bottom: 18rpx; }

.search {
  display: flex; align-items: center; gap: 14rpx;
  background: #ffffff; border: 1rpx solid #e8e5de; border-radius: 18rpx;
  padding: 0 24rpx; height: 84rpx;
}
.sic { font-size: 28rpx; opacity: 0.55; }
.sinput { flex: 1; font-size: 27rpx; height: 84rpx; }
.sclr { color: #b5b5b5; font-size: 26rpx; padding: 0 6rpx; }

.bu-tabs { display: flex; flex-wrap: wrap; margin-top: 20rpx; }

.count { font-size: 23rpx; color: #8f8f8f; margin-bottom: 18rpx; }

.books { display: flex; flex-wrap: wrap; gap: 20rpx; }
.book {
  width: calc(50% - 10rpx);
  background: #ffffff; border: 1rpx solid #e8e5de; border-radius: 20rpx;
  overflow: hidden; position: relative;
  box-shadow: 0 2rpx 16rpx rgba(60, 50, 30, 0.05);
}
.cover {
  height: 240rpx; position: relative;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
}
.cover-frame {
  position: absolute; left: 16rpx; right: 16rpx; top: 16rpx; bottom: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.34); border-radius: 10rpx;
}
.cover-title {
  color: #ffffff; font-weight: 700; letter-spacing: 6rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  text-align: center; line-height: 1.35;
}
.cover-era {
  color: rgba(255, 255, 255, 0.75); font-size: 22rpx;
  letter-spacing: 3rpx; margin-top: 12rpx;
}

.favbtn {
  position: absolute; right: 18rpx; top: 16rpx;
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: rgba(0, 0, 0, 0.22); color: #ffffff;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx;
}
.favbtn.on { background: #ffffff; color: #c0504d; }

.bd { padding: 20rpx 22rpx 24rpx; }
.tt { display: flex; align-items: center; gap: 10rpx; }
.nm { font-size: 29rpx; font-weight: 700; }
.bu-tag {
  flex: 0 0 auto;
  font-size: 20rpx; color: #3d7a4f; background: #eaf3ec;
  border-radius: 6rpx; padding: 2rpx 10rpx;
}
.au { font-size: 22rpx; color: #8f8f8f; margin-top: 6rpx; }
.iv {
  font-size: 22rpx; color: #5f5f5f; margin-top: 10rpx; line-height: 1.6;
  height: 104rpx; overflow: hidden;
}
