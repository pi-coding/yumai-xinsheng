/* 登录 / 注册 */
.tabs {
  display: flex; margin: 4rpx 0 22rpx;
  background: #ffffff; border: 1rpx solid #e8e5de; border-radius: 24rpx; padding: 6rpx;
}
.tab {
  flex: 1; text-align: center; font-size: 27rpx; color: #7a7468;
  padding: 16rpx 0; border-radius: 18rpx;
}
.tab.on { background: #3d7a4f; color: #ffffff; font-weight: 600; }

.field { margin-bottom: 24rpx; }
.field:last-child { margin-bottom: 0; }
.fl { font-size: 24rpx; color: #8f8f8f; margin-bottom: 10rpx; }
.fi {
  height: 84rpx; background: #faf9f6; border: 1rpx solid #f0eee8; border-radius: 14rpx;
  padding: 0 24rpx; font-size: 27rpx;
}

.err {
  margin-top: 20rpx; padding: 18rpx 22rpx; border-radius: 14rpx;
  background: #fbeeed; color: #c0504d; font-size: 25rpx; line-height: 1.6;
}

.acts { display: flex; gap: 20rpx; }
.acts .btn { flex: 1; }

/* 后端地址折叠块：外壳用全局 .acc，这里只留动作行与提示 */
.kb-acts { display: flex; gap: 28rpx; margin: 16rpx 0 14rpx; }
.kb-a { font-size: 25rpx; color: #3d7a4f; font-weight: 600; }

