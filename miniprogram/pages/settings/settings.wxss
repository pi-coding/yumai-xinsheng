.opt {
  display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx;
  padding: 26rpx 0; border-bottom: 1rpx solid #f0eee8;
}
.opt:last-child { border-bottom: none; }
.obd { flex: 1; }
.ot { font-size: 28rpx; font-weight: 700; display: flex; align-items: center; flex-wrap: wrap; }
.od { font-size: 23rpx; color: #8f8f8f; line-height: 1.7; margin-top: 8rpx; }

.field { margin-bottom: 24rpx; }
.field:last-child { margin-bottom: 0; }
.fl { font-size: 24rpx; color: #8f8f8f; margin-bottom: 10rpx; }
.fi {
  height: 84rpx; background: #faf9f6; border: 1rpx solid #f0eee8; border-radius: 14rpx;
  padding: 0 24rpx; font-size: 26rpx;
}

/* 服务端地址的动作行 */
.kb-acts { display: flex; gap: 28rpx; margin: 18rpx 0 14rpx; }
.kb-a { font-size: 25rpx; color: #3d7a4f; font-weight: 600; }

/* 大模型配置：选中「大模型 API」时才出现，用分隔线跟上面的单选区分开 */
.apibox { margin-top: 24rpx; padding-top: 26rpx; border-top: 1rpx solid #f0eee8; }

.danger { color: #c0504d; border-color: #f2c9c7; }
