/* 模块四：我的 */

/* 数据 + 账号合成一张卡：上面三格数字，下面一行账号状态 */
.minebox .acct {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid #f0eee8;
}
.minebox .ac-t { font-size: 24rpx; color: #8f8f8f; flex: 1; min-width: 0; }
.minebox .ac-a { flex: 0 0 auto; margin-left: 16rpx; font-size: 24rpx; color: #3d7a4f; font-weight: 700; }

/* 两个页签：古籍 / 作品 */
.tabs { display: flex; gap: 16rpx; margin-bottom: 26rpx; }
.books { display: flex; flex-wrap: wrap; gap: 20rpx; }
.tab {
  flex: 1; height: 82rpx; border-radius: 18rpx;
  background: #ffffff; border: 1rpx solid #e8e5de;
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
  font-size: 27rpx; color: #5f5f5f;
}
.tab.on { background: #eaf3ec; border-color: #cfe3d5; color: #3d7a4f; font-weight: 700; }
.tab .num {
  font-size: 22rpx; background: #f0eee8; color: #8f8f8f;
  border-radius: 999rpx; padding: 0 12rpx; line-height: 34rpx;
}
.tab.on .num { background: #ffffff; color: #3d7a4f; }

/* 复用书库卡片样式（WXSS 不跨文件继承，此处重复定义） */
.books { display: flex; flex-wrap: wrap; gap: 20rpx; }
.book {
  width: calc(50% - 10rpx);
  background: #ffffff; border: 1rpx solid #e8e5de; border-radius: 20rpx;
  overflow: hidden; position: relative;
  box-shadow: 0 2rpx 16rpx rgba(60, 50, 30, 0.05);
}
.cover {
  height: 240rpx; position: relative;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
}
.cover-frame {
  position: absolute; left: 16rpx; right: 16rpx; top: 16rpx; bottom: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.34); border-radius: 10rpx;
}
.cover-title {
  color: #ffffff; font-weight: 700; letter-spacing: 6rpx;
  font-family: "Songti SC", "STSong", "SimSun", serif;
  text-align: center; line-height: 1.35;
}
.cover-era { color: rgba(255, 255, 255, 0.75); font-size: 22rpx; letter-spacing: 3rpx; margin-top: 12rpx; }
.favbtn {
  position: absolute; right: 18rpx; top: 16rpx;
  width: 56rpx; height: 56rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx; background: #ffffff; color: #c0504d;
}
.bd { padding: 20rpx 22rpx 24rpx; }
.tt { display: flex; align-items: center; gap: 10rpx; }
.nm { font-size: 29rpx; font-weight: 700; }
.bu-tag {
  flex: 0 0 auto; font-size: 20rpx; color: #3d7a4f; background: #eaf3ec;
  border-radius: 6rpx; padding: 2rpx 10rpx;
}
.au { font-size: 22rpx; color: #8f8f8f; margin-top: 6rpx; }
.iv {
  font-size: 22rpx; color: #5f5f5f; margin-top: 10rpx; line-height: 1.6;
  height: 104rpx; overflow: hidden;
}

/* 作品项 */
.witem { padding: 24rpx 0; border-bottom: 1rpx solid #f0eee8; }
.witem:last-child { border-bottom: none; }
.wt {
  font-size: 29rpx; line-height: 1.8;
  font-family: "Songti SC", "STSong", "SimSun", serif;
}
.wm { display: flex; align-items: center; gap: 16rpx; margin-top: 12rpx; font-size: 22rpx; color: #b5b5b5; }
.dir { color: #3d7a4f; background: #eaf3ec; border-radius: 6rpx; padding: 2rpx 12rpx; }
.at { flex: 1; }
.wacts { display: flex; gap: 16rpx; margin-top: 16rpx; }
.del { color: #c0504d; }

